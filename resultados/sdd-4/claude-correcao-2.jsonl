{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019doCHGKkTzg6z8Kax8A1Nx","type":"tool_result","content":"1\tpackage com.example.blog.usuario.web;\n2\t\n3\timport java.net.URI;\n4\t\n5\timport jakarta.validation.Valid;\n6\t\n7\timport org.springframework.http.ResponseEntity;\n8\timport org.springframework.security.core.annotation.AuthenticationPrincipal;\n9\timport org.springframework.security.oauth2.jwt.Jwt;\n10\timport org.springframework.web.bind.annotation.GetMapping;\n11\timport org.springframework.web.bind.annotation.PostMapping;\n12\timport org.springframework.web.bind.annotation.PutMapping;\n13\timport org.springframework.web.bind.annotation.RequestBody;\n14\timport org.springframework.web.bind.annotation.RequestMapping;\n15\timport org.springframework.web.bind.annotation.RestController;\n16\timport org.springframework.web.util.UriComponentsBuilder;\n17\t\n18\timport com.example.blog.shared.seguranca.TokenService;\n19\timport com.example.blog.usuario.service.UsuarioAutenticado;\n20\timport com.example.blog.usuario.service.UsuarioService;\n21\t\n22\timport tools.jackson.databind.JsonNode;\n23\t\n24\t/** Cadastro, login e usuário atual. */\n25\t@RestController\n26\t@RequestMapping(\"/api\")\n27\tpublic class UsuarioController {\n28\t\n29\t    private final UsuarioService usuarioService;\n30\t    private final TokenService tokenService;\n31\t    private final AlteracaoUsuarioMapper alteracaoUsuarioMapper;\n32\t\n33\t    public UsuarioController(UsuarioService usuarioService, TokenService tokenService,\n34\t            AlteracaoUsuarioMapper alteracaoUsuarioMapper) {\n35\t        this.usuarioService = usuarioService;\n36\t        this.tokenService = tokenService;\n37\t        this.alteracaoUsuarioMapper = alteracaoUsuarioMapper;\n38\t    }\n39\t\n40\t    @PostMapping(\"/users\")\n41\t    public ResponseEntity<UsuarioResponse> cadastrar(@Valid @RequestBody CadastroRequest requisicao) {\n42\t        CadastroRequest.Dados dados = requisicao.user();\n43\t        UsuarioAutenticado usuario = usuarioService.cadastrar(dados.username(), dados.email(), dados.password());\n44\t        URI perfil = UriComponentsBuilder.fromPath(\"/api/profiles/{username}\")\n45\t                .buildAndExpand(usuario.username())\n46\t                .encode()\n47\t                .toUri();\n48\t        return ResponseEntity.created(perfil).body(UsuarioResponse.de(usuario));\n49\t    }\n50\t\n51\t    @PostMapping(\"/users/login\")\n52\t    public UsuarioResponse entrar(@Valid @RequestBody LoginRequest requisicao) {\n53\t        LoginRequest.Dados dados = requisicao.user();\n54\t        return UsuarioResponse.de(usuarioService.autenticar(dados.email(), dados.password()));\n55\t    }\n56\t\n57\t    @GetMapping(\"/user\")\n58\t    public UsuarioResponse buscarAtual(@AuthenticationPrincipal Jwt jwt) {\n59\t        return UsuarioResponse.de(usuarioService.buscarAtual(tokenService.idDoUsuario(jwt), jwt.getTokenValue()));\n60\t    }\n61\t\n62\t    @PutMapping(\"/user\")\n63\t    public UsuarioResponse atualizar(@AuthenticationPrincipal Jwt jwt, @RequestBody JsonNode corpo) {\n64\t        return UsuarioResponse.de(usuarioService.atualizar(tokenService.idDoUsuario(jwt), jwt.getTokenValue(),\n65\t                alteracaoUsuarioMapper.converter(corpo)));\n66\t    }\n67\t}\n68\t"}]},"parent_tool_use_id":null,"session_id":"57ee6759-45fe-46ba-b2e4-dbb1eff65b7f","uuid":"60ebccc9-d87d-439c-8b3e-c0f3a50557a2","timestamp":"2026-11-02T00:11:08.993Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\sylla\\Documents\\tcc-wks\\execucoes\\sdd\\sdd-4\\src\\main\\java\\com\\example\\blog\\usuario\\web\\UsuarioController.java","content":"package com.example.blog.usuario.web;\n\nimport java.net.URI;\n\nimport jakarta.validation.Valid;\n\nimport org.springframework.http.ResponseEntity;\nimport org.springframework.security.core.annotation.AuthenticationPrincipal;\nimport org.springframework.security.oauth2.jwt.Jwt;\nimport org.springframework.web.bind.annotation.GetMapping;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.PutMapping;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.RestController;\nimport org.springframework.web.util.UriComponentsBuilder;\n\nimport com.example.blog.shared.seguranca.TokenService;\nimport com.example.blog.usuario.service.UsuarioAutenticado;\nimport com.example.blog.usuario.service.UsuarioService;\n\nimport tools.jackson.databind.JsonNode;\n\n/** Cadastro, login e usuário atual. */\n@RestController\n@RequestMapping(\"/api\")\npublic class UsuarioController {\n\n    private final UsuarioService usuarioService;\n    private final TokenService tokenService;\n    private final AlteracaoUsuarioMapper alteracaoUsuarioMapper;\n\n    public UsuarioController(UsuarioService usuarioService, TokenService tokenService,\n            AlteracaoUsuarioMapper alteracaoUsuarioMapper) {\n        this.usuarioService = usuarioService;\n        this.tokenService = tokenService;\n        this.alteracaoUsuarioMapper = alteracaoUsuarioMapper;\n    }\n\n    @PostMapping(\"/users\")\n    public ResponseEntity<UsuarioResponse> cadastrar(@Valid @RequestBody CadastroRequest requisicao) {\n        CadastroRequest.Dados dados = requisicao.user();\n        UsuarioAutenticado usuario = usuarioService.cadastrar(dados.username(), dados.email(), dados.password());\n        URI perfil = UriComponentsBuilder.fromPath(\"/api/profiles/{username}\")\n                .buildAndExpand(usuario.username())\n                .encode()\n                .toUri();\n        return ResponseEntity.created(perfil).body(UsuarioResponse.de(usuario));\n    }\n\n    @PostMapping(\"/users/login\")\n    public UsuarioResponse entrar(@Valid @RequestBody LoginRequest requisicao) {\n        LoginRequest.Dados dados = requisicao.user();\n        return UsuarioResponse.de(usuarioService.autenticar(dados.email(), dados.password()));\n    }\n\n    @GetMapping(\"/user\")\n    public UsuarioResponse buscarAtual(@AuthenticationPrincipal Jwt jwt) {\n        return UsuarioResponse.de(usuarioService.buscarAtual(tokenService.idDoUsuario(jwt), jwt.getTokenValue()));\n    }\n\n    @PutMapping(\"/user\")\n    public UsuarioResponse atualizar(@AuthenticationPrincipal Jwt jwt, @RequestBody JsonNode corpo) {\n        return UsuarioResponse.de(usuarioService.atualizar(tokenService.idDoUsuario(jwt), jwt.getTokenValue(),\n                alteracaoUsuarioMapper.converter(corpo)));\n    }\n}\n","numLines":68,"startLine":1,"totalLines":68}},"tool_result_meta":[{"id":"toolu_019doCHGKkTzg6z8Kax8A1Nx","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
